# Скопируйте в .env и поменяйте ключ. Этот ключ вы передаёте жюри.
OKO_API_KEYS=change-me-long-random-key

# Детекторы через запятую: obstruction (камера перекрыта), demo (только для проверки интерфейса!)
OKO_DETECTORS=obstruction

# Сколько видео анализировать одновременно (ограничено памятью GPU)
OKO_WORKERS=2

# Бюджет от загрузки до ответа, с. Лимит жюри — 300 с, оставляем запас на сеть.
OKO_DEADLINE_SEC=240
OKO_RESERVE_SEC=20

# Частота кадров, которые видят детекторы
OKO_SAMPLE_FPS=5

# С какой уверенности нарушение попадает в API; от REVIEW до THRESHOLD — только «на проверку» в интерфейсе
OKO_THRESHOLD=0.5
OKO_REVIEW_THRESHOLD=0.3

OKO_MAX_UPLOAD_MB=500
OKO_MAX_QUEUE=50

# auto — пикселизировать найденные лица; detector — только области от детекторов; off — выключить
OKO_FACE_BLUR=auto

# Хранить ли загруженные видео после анализа (по правилам хакатона лучше не хранить)
OKO_KEEP_VIDEOS=false

# Добавлять в ответ API rule_id и confidence (сверх схемы ТЗ). Включайте, только если организаторы разрешили.
OKO_API_EXTRA_FIELDS=false

# auto — GPU, если есть torch с CUDA или nvidia-smi; cpu / cuda — принудительно
OKO_DEVICE=auto
